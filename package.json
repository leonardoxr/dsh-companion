{
  "name": "dsh-companion",
  "version": "0.4.4",
  "description": "Read-only workspace and session JSON API for DeepSeek Harness clients",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "default": "./client/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "client/",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "node -e \"for (const dir of ['dist', 'client']) require('node:fs').rmSync(dir, { recursive: true, force: true })\" && tsc -p tsconfig.json && tsc -p tsconfig.client.json --noEmit && tsdown && node scripts/normalize-client-banner.mjs",
    "test": "npm run build && node --test",
    "prepack": "npm test"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "native-client",
    "typescript"
  ],
  "author": "leonardoxr",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leonardoxr/dsh-companion.git"
  },
  "homepage": "https://github.com/leonardoxr/dsh-companion#readme",
  "bugs": {
    "url": "https://github.com/leonardoxr/dsh-companion/issues"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-connection": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-runtime": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "^0.1.1-rc.2",
    "@types/node": "^26.2.0",
    "@types/react": "~19.2.18",
    "react": "^19.2.8",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  }
}
